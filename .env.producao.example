# .env do servidor de produção (Docker). O scripts/instalar-producao.sh copia este arquivo para .env
# e preenche APP_KEY, DB_PASSWORD e APP_URL. Não use aspas com ${...} aqui: o Docker lê este arquivo.
COMPOSE_FILE=docker-compose.producao.yml

APP_NAME="Controle de Projetos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://IP-DO-SERVIDOR:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Porta do servidor onde o sistema fica disponível (http://IP-DO-SERVIDOR:APP_PORTA).
APP_PORTA=8000

BCRYPT_ROUNDS=12

# Logs vão para "docker compose logs app".
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_DATABASE=controle_projetos
DB_USERNAME=controle_projetos
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# E-mail do "Esqueci minha senha" (RN-37). Com "log" o e-mail não é enviado: o link aparece nos logs.
# Para enviar de verdade, troque para smtp e preencha os dados do seu provedor.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="Controle de Projetos"
